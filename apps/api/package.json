{
  "name": "@booking/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "worker": "node dist/worker.js",
    "worker:dev": "nest start --watch --entryFile worker",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPatterns=\\.spec\\.ts$",
    "test:int": "jest --runInBand --testPathPatterns=\\.int\\.ts$",
    "load-test": "node scripts/load-test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset:test": "tsx scripts/reset-test-db.ts",
    "db:reset:dev": "tsx prisma/reset-dev.ts",
    "superadmin:create": "tsx src/cli/create-superadmin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@booking/shared": "*",
    "@nestjs/common": "~11.2.11",
    "@nestjs/core": "~11.2.11",
    "@nestjs/platform-express": "~11.2.11",
    "@nestjs/swagger": "~11.4.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "isbot": "^5.2.3",
    "luxon": "^3.7.2",
    "nestjs-pino": "^5.3.2",
    "nestjs-zod": "^5.6.0",
    "otplib": "^12.0.1",
    "pg": "^8.16.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "~11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "~11.2.11",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "pino-pretty": "^13.0.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.20.3",
    "typescript": "~5.9.3"
  }
}
