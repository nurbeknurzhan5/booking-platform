  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  promotion   Promotion   @relation(fields: [organizationId, promotionId], references: [organizationId, id], onDelete: Restrict)
  appointment Appointment @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Cascade)
  client      Client      @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, appointmentId])
  @@index([promotionId, status])
  @@index([promotionId, clientId])
  @@map("promotion_redemptions")
}

model AnalyticsEvent {
  id             BigInt   @id @default(autoincrement())
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  type           String   @db.VarChar(30)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Дневной хэш посетителя без cookies (D-19).
  visitorHash    String   @map("visitor_hash") @db.VarChar(64)
  sessionId      String?  @map("session_id") @db.VarChar(64)
  utmSource      String?  @map("utm_source") @db.VarChar(100)
  utmMedium      String?  @map("utm_medium") @db.VarChar(100)
  utmCampaign    String?  @map("utm_campaign") @db.VarChar(100)
  utmTerm        String?  @map("utm_term") @db.VarChar(100)
  utmContent     String?  @map("utm_content") @db.VarChar(100)
  referrerHost   String?  @map("referrer_host") @db.VarChar(200)
  isBot          Boolean  @default(false) @map("is_bot")
  isInternal     Boolean  @default(false) @map("is_internal")
  appointmentId  String?  @map("appointment_id") @db.Uuid
  serviceIds     String[] @map("service_ids") @db.Uuid

  branch Branch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)

  @@index([branchId, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("analytics_events")
}

model AnalyticsDailyAggregate {
  organizationId  String   @map("organization_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  date            DateTime @db.Date
  pageViews       Int      @default(0) @map("page_views")
  uniqueVisitors  Int      @default(0) @map("unique_visitors")
  bookingClicks   Int      @default(0) @map("booking_clicks")
  bookingStarts   Int      @default(0) @map("booking_starts")
  bookingsCreated Int      @default(0) @map("bookings_created")
  cancellations   Int      @default(0)
  /// { "<utm_source|referrer|direct>": { views, uniques, bookings } }
  sources         Json     @default("{}")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)

  @@id([branchId, date])
  @@index([organizationId, date])
  @@map("analytics_daily_aggregates")
}

model IntegrationSetting {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// NULL — системная настройка платформы.
  organizationId String?  @map("organization_id") @db.Uuid
  provider       String   @db.VarChar(40)
  config         Json     @default("{}")
  /// Секреты шифруются AES-256-GCM ключом из переменной окружения.
  secretEnc      String?  @map("secret_enc")
  isEnabled      Boolean  @default(false) @map("is_enabled")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, provider])
  @@map("integration_settings")
}

model SystemSetting {
  key             String   @id @db.VarChar(60)
  value           Json
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

// ================= ИНФРАСТРУКТУРА =================

/// Счётчики rate limit (UNLOGGED-таблица, см. миграцию constraints).
model RateLimitBucket {
  key       String   @id @db.VarChar(200)
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

/// Очередь фоновых задач на PostgreSQL (SKIP LOCKED).
model Job {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queue       String    @db.VarChar(60)
  payload     Json      @default("{}")
  status      JobStatus @default(pending)
  dedupeKey   String?   @unique @map("dedupe_key") @db.VarChar(200)
  runAt       DateTime  @default(now()) @map("run_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy    String?   @map("locked_by") @db.VarChar(100)
  lastError   String?   @map("last_error")
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([queue, status, runAt])
  @@map("jobs")
}
