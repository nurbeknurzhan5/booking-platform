model PageHistory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  pageId         String   @map("page_id") @db.Uuid
  action         String   @db.VarChar(40)
  publicationId  String?  @map("publication_id") @db.Uuid
  templateId     String?  @map("template_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  details        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  page PublicPage @relation(fields: [organizationId, pageId], references: [organizationId, id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@map("page_history")
}

/// Переводы контента (страница, услуги, специалисты, категории, акции) — §13.5.
model PageTranslation {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  entityType      String            @map("entity_type") @db.VarChar(30)
  entityId        String            @map("entity_id") @db.Uuid
  field           String            @db.VarChar(60)
  locale          String            @db.VarChar(2)
  text            String?
  status          TranslationStatus @default(missing)
  /// auto | manual
  source          String?           @db.VarChar(10)
  sourceLocale    String            @map("source_locale") @db.VarChar(2)
  /// SHA-256 исходного текста — для определения устаревших переводов.
  sourceHash      String?           @map("source_hash") @db.VarChar(64)
  isOutdated      Boolean           @default(false) @map("is_outdated")
  updatedByUserId String?           @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, entityType, entityId, field, locale])
  @@index([organizationId, status])
  @@map("page_translations")
}

/// Медиафайлы (логотипы, фото, изображения услуг и специалистов) — §24. Файлы лежат в объектном хранилище.
model MediaAsset {
