  organizationId   String?   @map("organization_id") @db.Uuid
  kind             String    @db.VarChar(30)
  storageKey       String    @unique @map("storage_key") @db.VarChar(300)
  mimeType         String    @map("mime_type") @db.VarChar(50)
  width            Int
  height           Int
  sizeBytes        Int       @map("size_bytes")
  /// { thumb: key, medium: key, large: key }
  variants         Json
  originalName     String?   @map("original_name") @db.VarChar(255)
  uploadedByUserId String?   @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
