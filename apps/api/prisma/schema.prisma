// Схема БД платформы онлайн-записи. ERD и правила: docs/ERD.md
// Ограничения, которые Prisma не выражает (EXCLUDE, частичные уникальные индексы, CHECK, триггеры),
// находятся в ручных SQL-миграциях (prisma/migrations/*_constraints).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Импорты без расширения: совместимо с CommonJS-сборкой (SWC) и Jest.
  importFileExtension = ""
}

// Расширения btree_gist, citext, pgcrypto создаются в первой миграции.
datasource db {
  provider = "postgresql"
}

// ================= ENUMS =================

enum AppointmentStatus {
  pending_otp
  confirmed
  completed
  no_show
  cancelled_by_client
  cancelled_by_admin
  expired_otp
}

enum SubscriptionStatus {
  active
  grace_period
  expired
  suspended
}

enum PageStatus {
  active
  temporarily_closed
  disabled
}

enum ResourceType {
  specialist
  cabinet
  hall
  equipment
  vehicle
  service_bay
  other
}

enum TranslationStatus {
  missing
  auto_translated
  verified
  manually_edited
}

enum NotificationStatus {
  pending
  sending
  sent
  delivered
  read
  failed
  dead
  cancelled
}

enum NotificationChannel {
  whatsapp
  sms
  email
  dev_inbox
}

enum DiscountType {
  percent
  fixed
}

enum PromotionKind {
  promo_code
  sale
}

enum ReviewStatus {
  published
  hidden
}

enum TemplateStatus {
  draft
  published
  disabled
}

enum MultiServiceMode {
  sequential
  parallel
}

enum JobStatus {
  pending
  running
  done
  failed
  dead
}

// ================= ПОЛЬЗОВАТЕЛИ И ДОСТУП (§20.1) =================

model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String?   @unique @db.Citext
  phone              String?   @unique @db.VarChar(16)
  phoneVerifiedAt    DateTime? @map("phone_verified_at") @db.Timestamptz(3)
  name               String    @db.VarChar(200)
  passwordHash       String?   @map("password_hash")
  isSuperadmin       Boolean   @default(false) @map("is_superadmin")
  mfaSecretEnc       String?   @map("mfa_secret_enc")
  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  locale             String    @default("ru") @db.VarChar(2)
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  blockedAt          DateTime? @map("blocked_at") @db.Timestamptz(3)
  blockedReason      String?   @map("blocked_reason")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions     UserSession[]
  orgRoles     UserOrganizationRole[]
  branchAccess UserBranchAccess[]
  clients      Client[]
  auditLogs    AuditLog[]
  consents     ClientConsent[]

  @@map("users")
}

model UserSession {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  kind        String    @db.VarChar(10) // staff | client
  mfaVerified Boolean   @default(false) @map("mfa_verified")
  ip          String?   @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.VarChar(500)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model OtpCode {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone         String    @db.VarChar(16)
  purpose       String    @db.VarChar(20) // login | booking
  /// HMAC-SHA256(code) с серверным секретом. Код в открытом виде не хранится.
  codeHash      String    @map("code_hash") @db.VarChar(64)
  appointmentId String?   @map("appointment_id") @db.Uuid
  attempts      Int       @default(0)
  maxAttempts   Int       @map("max_attempts")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  ip            String?   @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([phone, purpose, createdAt])
  @@index([ip, createdAt])
  @@index([appointmentId])
  @@map("otp_codes")
}

model Role {
  code        String                 @id @db.VarChar(30)
  name        String                 @db.VarChar(100)
  permissions RolePermission[]
  orgRoles    UserOrganizationRole[]
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("roles")
}

model Permission {
  code         String                 @id @db.VarChar(60)
  scope        String                 @db.VarChar(10) // branch | org
  description  String                 @db.VarChar(200)
  roles        RolePermission[]
  branchGrants UserBranchPermission[]
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("permissions")
}

model RolePermission {
  roleCode       String     @map("role_code") @db.VarChar(30)
  permissionCode String     @map("permission_code") @db.VarChar(60)
  role           Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  @@map("role_permissions")
}

model UserOrganizationRole {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  roleCode       String    @map("role_code") @db.VarChar(30)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleCode], references: [code])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("user_organization_roles")
}

model UserBranchAccess {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch      Branch                 @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  permissions UserBranchPermission[]

  @@unique([userId, branchId])
  @@index([organizationId])
  @@map("user_branch_access")
}

model UserBranchPermission {
  accessId       String           @map("access_id") @db.Uuid
  permissionCode String           @map("permission_code") @db.VarChar(60)
  access         UserBranchAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)
  permission     Permission       @relation(fields: [permissionCode], references: [code])

  @@id([accessId, permissionCode])
  @@map("user_branch_permissions")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorType      String   @map("actor_type") @db.VarChar(20) // user | superadmin | client | system
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(60)
  entityId       String?  @map("entity_id") @db.VarChar(64)
  before         Json?
  after          Json?
  ip             String?  @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ================= SAAS (§20.2) =================

model BusinessCategory {
  code          String         @id @db.VarChar(40)
  nameRu        String         @map("name_ru") @db.VarChar(100)
  nameKk        String         @map("name_kk") @db.VarChar(100)
  nameEn        String         @map("name_en") @db.VarChar(100)
  isActive      Boolean        @default(true) @map("is_active")
  sortOrder     Int            @default(0) @map("sort_order")
  organizations Organization[]
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("business_categories")
}

model Organization {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String    @db.VarChar(200)
  businessCategoryCode String    @map("business_category_code") @db.VarChar(40)
  description          String?
  contacts             Json      @default("{}")
  defaultLocale        String    @default("ru") @map("default_locale") @db.VarChar(2)
  notificationSettings Json      @default("{}") @map("notification_settings")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt           DateTime? @map("archived_at") @db.Timestamptz(3)

  businessCategory  BusinessCategory       @relation(fields: [businessCategoryCode], references: [code])
  members           UserOrganizationRole[]
  branches          Branch[]
  subscription      Subscription?
  payments          SubscriptionPayment[]
  subscriptionLog   SubscriptionHistory[]
  serviceCategories ServiceCategory[]
  services          Service[]
  clients           Client[]
  promotions        Promotion[]
  auditLogs         AuditLog[]
  assets            MediaAsset[]
  translations      PageTranslation[]
  integrations      IntegrationSetting[]
  whatsappAccounts  WhatsappAccount[]
  consents          ClientConsent[]

  @@map("organizations")
}

model Plan {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String         @unique @db.VarChar(40)
  name          String         @db.VarChar(200)
  description   String?
  maxBranches   Int            @map("max_branches")
  monthlyPrice  Int            @map("monthly_price")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String             @unique @map("organization_id") @db.Uuid
  planId            String             @map("plan_id") @db.Uuid
  maxBranches       Int                @map("max_branches")
  price             Int
  startsAt          DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime           @map("ends_at") @db.Timestamptz(3)
  graceDays         Int                @default(7) @map("grace_days")
  /// Последний вычисленный статус (пересчитывается воркером и при каждом изменении).
  status            SubscriptionStatus
  suspended         Boolean            @default(false)
  suspendedReason   String?            @map("suspended_reason")
  lastPaymentAt     DateTime?          @map("last_payment_at") @db.Timestamptz(3)
  lastPaymentAmount Int?               @map("last_payment_amount")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         Plan                  @relation(fields: [planId], references: [id])
  payments     SubscriptionPayment[]
  history      SubscriptionHistory[]

  @@map("subscriptions")
}

model SubscriptionPayment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  subscriptionId   String   @map("subscription_id") @db.Uuid
  amount           Int
  paidAt           DateTime @map("paid_at") @db.Timestamptz(3)
  method           String   @db.VarChar(30)
  reference        String?  @db.VarChar(200)
  note             String?
  recordedByUserId String?  @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([organizationId, paidAt])
  @@map("subscription_payments")
}

model SubscriptionHistory {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  action         String              @db.VarChar(40)
  fromStatus     SubscriptionStatus? @map("from_status")
  toStatus       SubscriptionStatus? @map("to_status")
  snapshot       Json
  actorUserId    String?             @map("actor_user_id") @db.Uuid
  note           String?
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("subscription_history")
}

// ================= ФИЛИАЛЫ =================

model Branch {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(200)
  /// Постоянная ссылка публичной страницы. Не меняется при смене шаблона.
  slug           String    @unique @db.VarChar(60)
  address        String?   @db.VarChar(500)
  phone          String?   @db.VarChar(16)
  timezone       String    @default("Asia/Almaty") @db.VarChar(64)
  description    String?
  latitude       Float?
  longitude      Float?
  mapUrl         String?   @map("map_url") @db.VarChar(500)
  mapEnabled     Boolean   @default(true) @map("map_enabled")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  access           UserBranchAccess[]
  bookingSettings  BookingSettings?
  shifts           StaffShift[]
  branchServices   BranchService[]
  resources        Resource[]
  specialists      Specialist[]
  workingHours     WorkingHours[]
  breaks           Break[]
  exceptions       ScheduleException[]
  appointments     Appointment[]
  page             PublicPage?
  reviews          Review[]
  waitlist         WaitlistEntry[]
  waitlistReleases WaitlistRelease[]
  analyticsEvents  AnalyticsEvent[]
  analyticsDaily   AnalyticsDailyAggregate[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("branches")
}

model BookingSettings {
  branchId                       String           @id @map("branch_id") @db.Uuid
  organizationId                 String           @map("organization_id") @db.Uuid
  slotIntervalMinutes            Int              @default(15) @map("slot_interval_minutes")
  holdMinutes                    Int              @default(5) @map("hold_minutes")
  holdExtensionAllowed           Boolean          @default(true) @map("hold_extension_allowed")
  minLeadMinutes                 Int              @default(60) @map("min_lead_minutes")
  maxHorizonDays                 Int              @default(60) @map("max_horizon_days")
  rescheduleDeadlineMinutes      Int              @default(120) @map("reschedule_deadline_minutes")
  cancelDeadlineMinutes          Int              @default(120) @map("cancel_deadline_minutes")
  allowLateCancelException       Boolean          @default(false) @map("allow_late_cancel_exception")
  maxActiveAppointmentsPerClient Int              @default(3) @map("max_active_appointments_per_client")
  allowRebookWithActive          Boolean          @default(true) @map("allow_rebook_with_active")
  adminCanOverrideClientLimits   Boolean          @default(true) @map("admin_can_override_client_limits")
  multiServiceMode               MultiServiceMode @default(sequential) @map("multi_service_mode")
  loadBalancing                  Boolean          @default(true) @map("load_balancing")
  specialistPricingEnabled       Boolean          @default(false) @map("specialist_pricing_enabled")
  reminderHoursBefore            Int              @default(24) @map("reminder_hours_before")
  onlineBookingEnabled           Boolean          @default(true) @map("online_booking_enabled")
  // Лист ожидания (§9)
  waitlistEnabled                Boolean          @default(false) @map("waitlist_enabled")
  waitlistOfferMinutes           Int              @default(15) @map("waitlist_offer_minutes")
  waitlistRecipients             Int              @default(3) @map("waitlist_recipients")
  /// fifo | priority
  waitlistPriority               String           @default("fifo") @map("waitlist_priority") @db.VarChar(20)
  /// offer_next | release
  waitlistAfterExpiry            String           @default("offer_next") @map("waitlist_after_expiry") @db.VarChar(20)
  /// weekly — специалисты работают по недельному графику; shifts — только в назначенные смены (задача 21)
  scheduleMode                   String           @default("weekly") @map("schedule_mode") @db.VarChar(10)
  createdAt                      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, branchId])
  @@map("booking_settings")
}

// ================= УСЛУГИ (§20.3) =================

model ServiceCategory {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(200)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  services     Service[]

  @@unique([organizationId, id])
  @@map("service_categories")
}

model Service {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  categoryId           String?   @map("category_id") @db.Uuid
  name                 String    @db.VarChar(200)
  description          String?
  photoAssetId         String?   @map("photo_asset_id") @db.Uuid
  price                Int
  durationMinutes      Int       @map("duration_minutes")
  bufferBeforeMinutes  Int       @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes   Int       @default(0) @map("buffer_after_minutes")
  requiresSpecialist   Boolean   @default(true) @map("requires_specialist")
  isActive             Boolean   @default(true) @map("is_active")
  onlineBookingEnabled Boolean   @default(true) @map("online_booking_enabled")
  sortOrder            Int       @default(0) @map("sort_order")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt           DateTime? @map("archived_at") @db.Timestamptz(3)

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category         ServiceCategory?    @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  photo            MediaAsset?         @relation(fields: [organizationId, photoAssetId], references: [organizationId, id], onDelete: Restrict)
  branchServices   BranchService[]
  requirements     ServiceResource[]
  specialists      SpecialistService[]
  resources        ResourceService[]
  appointmentItems AppointmentItem[]

  @@unique([organizationId, id])
  @@index([organizationId, sortOrder])
  @@map("services")
}

model BranchService {
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  serviceId      String   @map("service_id") @db.Uuid
  priceOverride  Int?     @map("price_override")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch  Branch  @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  service Service @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Cascade)

  @@id([branchId, serviceId])
  @@index([organizationId, serviceId])
  @@map("branch_services")
}

/// Требования услуги к ресурсам: «нужен quantity ресурсов типа resource_type, поддерживающих услугу».
model ServiceResource {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  serviceId      String       @map("service_id") @db.Uuid
  resourceType   ResourceType @map("resource_type")
  quantity       Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  service Service @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Cascade)

  @@unique([serviceId, resourceType])
  @@map("service_resources")
}

// ================= РЕСУРСЫ И СПЕЦИАЛИСТЫ (§6) =================

model Resource {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  branchId       String       @map("branch_id") @db.Uuid
  type           ResourceType
  name           String       @db.VarChar(200)
  description    String?
  /// Показывать на публичной странице (места, залы, оборудование — задача 22). Специалисты показываются через свою карточку.
  isPublic       Boolean      @default(false) @map("is_public")
  photoAssetId   String?      @map("photo_asset_id") @db.Uuid
  isActive       Boolean      @default(true) @map("is_active")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(3)

  branch       Branch                @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  photo        MediaAsset?           @relation(fields: [organizationId, photoAssetId], references: [organizationId, id], onDelete: Restrict)
  shifts       StaffShift[]
  specialist   Specialist?
  services     ResourceService[]
  workingHours WorkingHours[]
  breaks       Break[]
  exceptions   ScheduleException[]
  bookings     AppointmentResource[]

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, id])
  @@index([branchId, type])
  @@map("resources")
}

/// Список услуг, которые поддерживает ресурс (кабинет, пост и т.д.).
model ResourceService {
  organizationId String   @map("organization_id") @db.Uuid
  resourceId     String   @map("resource_id") @db.Uuid
  serviceId      String   @map("service_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  resource Resource @relation(fields: [organizationId, resourceId], references: [organizationId, id], onDelete: Cascade)
  service  Service  @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Cascade)

  @@id([resourceId, serviceId])
  @@index([serviceId])
  @@map("resource_services")
}

model Specialist {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  /// Специалист — ресурс типа specialist (универсальная модель занятости).
  resourceId     String    @unique @map("resource_id") @db.Uuid
  /// Необязательная связь с сотрудником (один сотрудник — разные карточки в разных филиалах).
  userId         String?   @map("user_id") @db.Uuid
  name           String    @db.VarChar(200)
  specialization String?   @db.VarChar(200)
  description    String?
  photoAssetId   String?   @map("photo_asset_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  isPublic       Boolean   @default(true) @map("is_public")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)

  branch   Branch              @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  resource Resource            @relation(fields: [organizationId, branchId, resourceId], references: [organizationId, branchId, id], onDelete: Restrict)
  photo    MediaAsset?         @relation(fields: [organizationId, photoAssetId], references: [organizationId, id], onDelete: Restrict)
  services SpecialistService[]
  items    AppointmentItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, branchId, resourceId])
  @@index([branchId])
  @@map("specialists")
}

model SpecialistService {
  organizationId String   @map("organization_id") @db.Uuid
  specialistId   String   @map("specialist_id") @db.Uuid
  serviceId      String   @map("service_id") @db.Uuid
  priceOverride  Int?     @map("price_override")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  specialist Specialist @relation(fields: [organizationId, specialistId], references: [organizationId, id], onDelete: Cascade)
  service    Service    @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Cascade)

  @@id([specialistId, serviceId])
  @@index([serviceId])
  @@map("specialist_services")
}

// ================= РАСПИСАНИЯ (§7) =================

/// Рабочие интервалы по дням недели. resource_id = NULL — расписание филиала.
/// Время — минуты от полуночи в часовом поясе филиала.
model WorkingHours {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  resourceId     String?  @map("resource_id") @db.Uuid
  weekday        Int // 1..7 (ISO)
  startMinute    Int      @map("start_minute")
  endMinute      Int      @map("end_minute")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch   Branch    @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  resource Resource? @relation(fields: [organizationId, resourceId], references: [organizationId, id], onDelete: Cascade)

  @@index([branchId, resourceId])
  @@map("working_hours")
}

model Break {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  resourceId     String?  @map("resource_id") @db.Uuid
  weekday        Int
  startMinute    Int      @map("start_minute")
  endMinute      Int      @map("end_minute")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch   Branch    @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  resource Resource? @relation(fields: [organizationId, resourceId], references: [organizationId, id], onDelete: Cascade)

  @@index([branchId, resourceId])
  @@map("breaks")
}

/// Исключения: праздники, выходные, отпуск, временное закрытие (closed) или особые часы (custom_hours).
model ScheduleException {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  resourceId     String?  @map("resource_id") @db.Uuid
  dateFrom       DateTime @map("date_from") @db.Date
  dateTo         DateTime @map("date_to") @db.Date
  kind           String   @db.VarChar(20)
  /// [{ start: minute, end: minute }]
  intervals      Json     @default("[]")
  reason         String?  @db.VarChar(300)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch   Branch    @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  resource Resource? @relation(fields: [organizationId, resourceId], references: [organizationId, id], onDelete: Cascade)

  @@index([branchId, dateFrom, dateTo])
  @@map("schedule_exceptions")
}

/// Смена специалиста на дату (режим графика «по сменам»). Время — минуты от полуночи по часовому поясу филиала.
model StaffShift {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  resourceId      String   @map("resource_id") @db.Uuid
  date            DateTime @db.Date
  startMinute     Int      @map("start_minute")
  endMinute       Int      @map("end_minute")
  breakStart      Int?     @map("break_start")
  breakEnd        Int?     @map("break_end")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch   Branch   @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  resource Resource @relation(fields: [organizationId, branchId, resourceId], references: [organizationId, branchId, id], onDelete: Restrict)

  @@unique([resourceId, date])
  @@index([branchId, date])
  @@map("staff_shifts")
}

// ================= КЛИЕНТЫ И ЗАПИСИ (§20.4) =================

/// Карточка клиента внутри организации. Платформенный профиль — users (решение D-10).
model Client {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  name           String    @db.VarChar(200)
  phone          String    @db.VarChar(16)
  locale         String    @default("ru") @db.VarChar(2)
  notes          String?
  mergedIntoId   String?   @map("merged_into_id") @db.Uuid
  anonymizedAt   DateTime? @map("anonymized_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  mergedInto   Client?               @relation("ClientMerge", fields: [organizationId, mergedIntoId], references: [organizationId, id], onDelete: Restrict)
  mergedFrom   Client[]              @relation("ClientMerge")
  appointments Appointment[]
  reviews      Review[]
  redemptions  PromotionRedemption[]
  waitlist     WaitlistEntry[]
  consents     ClientConsent[]

  @@unique([organizationId, id])
  @@index([organizationId, phone])
  @@index([userId])
  @@map("clients")
}

/// Журнал согласий (append-only). Текущее значение — последняя запись по типу.
model ClientConsent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  clientId       String?  @map("client_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  phone          String   @db.VarChar(16)
  consentType    String   @map("consent_type") @db.VarChar(30) // personal_data | notifications | whatsapp | marketing
  granted        Boolean
  textVersion    String   @map("text_version") @db.VarChar(20)
  source         String   @db.VarChar(30)
  ip             String?  @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client?       @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, consentType, createdAt])
  @@index([clientId])
  @@map("client_consents")
}

model Appointment {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  branchId           String            @map("branch_id") @db.Uuid
  clientId           String            @map("client_id") @db.Uuid
  status             AppointmentStatus
  startAt            DateTime          @map("start_at") @db.Timestamptz(3)
  endAt              DateTime          @map("end_at") @db.Timestamptz(3)
  timezone           String            @db.VarChar(64)
  source             String            @db.VarChar(20) // online | admin
  locale             String            @default("ru") @db.VarChar(2)
  comment            String?
  /// SHA-256 токена ссылки управления записью (гостевая запись, D-11).
  manageTokenHash    String?           @unique @map("manage_token_hash") @db.VarChar(64)
  // --- snapshot цены (§5, §12) ---
  currency           String            @default("KZT") @db.VarChar(3)
  baseTotal          Int               @map("base_total")
  saleDiscountTotal  Int               @default(0) @map("sale_discount_total")
  promoDiscountTotal Int               @default(0) @map("promo_discount_total")
  totalPrice         Int               @map("total_price")
  promoCode          String?           @map("promo_code") @db.VarChar(50)
  promotionId        String?           @map("promotion_id") @db.Uuid
  // --- жизненный цикл ---
  confirmedAt        DateTime?         @map("confirmed_at") @db.Timestamptz(3)
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelReason       String?           @map("cancel_reason")
  rescheduleCount    Int               @default(0) @map("reschedule_count")
  reminderSentAt     DateTime?         @map("reminder_sent_at") @db.Timestamptz(3)
  createdByUserId    String?           @map("created_by_user_id") @db.Uuid
  // --- атрибуция (§17) ---
  visitorSession     String?           @map("visitor_session") @db.VarChar(64)
  utm                Json?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch        Branch                     @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  client        Client                     @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)
  items         AppointmentItem[]
  resources     AppointmentResource[]
  statusHistory AppointmentStatusHistory[]
  reschedules   AppointmentReschedule[]
  hold          BookingHold?
  review        Review?
  redemption    PromotionRedemption?

  @@unique([organizationId, id])
  @@index([organizationId, branchId, startAt])
  @@index([clientId, status])
  @@index([status, startAt])
  @@map("appointments")
}

model AppointmentItem {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  appointmentId          String   @map("appointment_id") @db.Uuid
  serviceId              String   @map("service_id") @db.Uuid
  specialistId           String?  @map("specialist_id") @db.Uuid
  position               Int
  startAt                DateTime @map("start_at") @db.Timestamptz(3)
  endAt                  DateTime @map("end_at") @db.Timestamptz(3)
  durationMinutes        Int      @map("duration_minutes")
  bufferBeforeMinutes    Int      @map("buffer_before_minutes")
  bufferAfterMinutes     Int      @map("buffer_after_minutes")
  /// Групповая бронь мест (D-41): сколько мест (ПК, консолей) занимает позиция; цена = цена услуги × места.
  seats                  Int      @default(1) @db.SmallInt
  serviceNameSnapshot    String   @map("service_name_snapshot") @db.VarChar(200)
  specialistNameSnapshot String?  @map("specialist_name_snapshot") @db.VarChar(200)
  basePrice              Int      @map("base_price")
  saleDiscount           Int      @default(0) @map("sale_discount")
  salePromotionId        String?  @map("sale_promotion_id") @db.Uuid
  promoDiscount          Int      @default(0) @map("promo_discount")
  finalPrice             Int      @map("final_price")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointment Appointment           @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Cascade)
  service     Service               @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict)
  specialist  Specialist?           @relation(fields: [organizationId, specialistId], references: [organizationId, id], onDelete: Restrict)
  resources   AppointmentResource[]

  @@unique([organizationId, id])
  @@index([appointmentId])
  @@index([specialistId, startAt])
  @@map("appointment_items")
}

/// Занятость ресурса. EXCLUDE-ограничение (миграция constraints) запрещает пересечение активных строк одного ресурса.
model AppointmentResource {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  appointmentId     String   @map("appointment_id") @db.Uuid
  appointmentItemId String   @map("appointment_item_id") @db.Uuid
  resourceId        String   @map("resource_id") @db.Uuid
  /// Интервал занятости с учётом буферов.
  startAt           DateTime @map("start_at") @db.Timestamptz(3)
  endAt             DateTime @map("end_at") @db.Timestamptz(3)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointment Appointment     @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Cascade)
  item        AppointmentItem @relation(fields: [organizationId, appointmentItemId], references: [organizationId, id], onDelete: Cascade)
  resource    Resource        @relation(fields: [organizationId, resourceId], references: [organizationId, id], onDelete: Restrict)

  @@index([resourceId, startAt])
  @@index([appointmentId])
  @@map("appointment_resources")
}

model AppointmentStatusHistory {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  appointmentId  String             @map("appointment_id") @db.Uuid
  fromStatus     AppointmentStatus? @map("from_status")
  toStatus       AppointmentStatus  @map("to_status")
  actorType      String             @map("actor_type") @db.VarChar(20)
  actorUserId    String?            @map("actor_user_id") @db.Uuid
  reason         String?
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_status_history")
}

model AppointmentReschedule {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  appointmentId  String   @map("appointment_id") @db.Uuid
  oldStartAt     DateTime @map("old_start_at") @db.Timestamptz(3)
  oldEndAt       DateTime @map("old_end_at") @db.Timestamptz(3)
  newStartAt     DateTime @map("new_start_at") @db.Timestamptz(3)
  newEndAt       DateTime @map("new_end_at") @db.Timestamptz(3)
  oldItems       Json     @map("old_items")
  newItems       Json     @map("new_items")
  actorType      String   @map("actor_type") @db.VarChar(20)
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_reschedules")
}

/// Временный резерв (§8.3). Пока released_at IS NULL, запись в pending_otp удерживает ресурсы.
model BookingHold {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  appointmentId  String    @unique @map("appointment_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  phone          String    @db.VarChar(16)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  extensionCount Int       @default(0) @map("extension_count")
  releasedAt     DateTime? @map("released_at") @db.Timestamptz(3)
  releaseReason  String?   @map("release_reason") @db.VarChar(20) // confirmed | expired | abandoned
  ip             String?   @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, appointmentId])
  @@index([expiresAt])
  @@map("booking_holds")
}

/// Лист ожидания (§9, D-24): заявка клиента на услуги в диапазоне дат.
model WaitlistEntry {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  serviceIds     String[]  @map("service_ids") @db.Uuid
  specialistId   String?   @map("specialist_id") @db.Uuid
  dateFrom       DateTime  @map("date_from") @db.Date
  dateTo         DateTime  @map("date_to") @db.Date
  /// pending_otp | waiting | offered | booked | cancelled | expired
  status         String    @default("waiting") @db.VarChar(20)
  priority       Int       @default(0)
  locale         String    @default("ru") @db.VarChar(2)
  /// online | admin
  source         String    @default("online") @db.VarChar(20)
  /// SHA-256 токена заявки (подтверждение OTP и выход из листа ожидания без входа в кабинет).
  tokenHash      String?   @unique @map("token_hash") @db.VarChar(64)
  appointmentId  String?   @map("appointment_id") @db.Uuid
  offeredAt      DateTime? @map("offered_at") @db.Timestamptz(3)
  offerExpiresAt DateTime? @map("offer_expires_at") @db.Timestamptz(3)
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch          @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  client Client          @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Cascade)
  offers WaitlistOffer[]

  @@unique([organizationId, id])
  @@index([branchId, status, dateFrom])
  @@index([clientId, status])
  @@map("waitlist_entries")
}

/// Освободившееся время (отмена или перенос записи) и раунды предложений по нему.
model WaitlistRelease {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  branchId            String    @map("branch_id") @db.Uuid
  sourceAppointmentId String?   @map("source_appointment_id") @db.Uuid
  startAt             DateTime  @map("start_at") @db.Timestamptz(3)
  endAt               DateTime  @map("end_at") @db.Timestamptz(3)
  /// Освободившиеся ресурсы: предлагается только время, которое использует хотя бы один из них.
  resourceIds         String[]  @default([]) @map("resource_ids") @db.Uuid
  /// pending | offering | booked | closed
  status              String    @default("pending") @db.VarChar(20)
  round               Int       @default(0)
  roundExpiresAt      DateTime? @map("round_expires_at") @db.Timestamptz(3)
  /// Заявки, которым уже предлагалось это время (не предлагаются повторно).
  offeredEntryIds     String[]  @default([]) @map("offered_entry_ids") @db.Uuid
  closedReason        String?   @map("closed_reason") @db.VarChar(40)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch          @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)
  offers WaitlistOffer[]

  @@unique([organizationId, id])
  @@index([status, roundExpiresAt])
  @@map("waitlist_releases")
}

/// Предложение времени клиенту из листа ожидания. Первый подтвердивший получает слот.
model WaitlistOffer {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  releaseId      String    @map("release_id") @db.Uuid
  entryId        String    @map("entry_id") @db.Uuid
  round          Int
  /// SHA-256 токена ссылки из уведомления.
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  startAt        DateTime  @map("start_at") @db.Timestamptz(3)
  endAt          DateTime  @map("end_at") @db.Timestamptz(3)
  /// pending | accepted | declined | expired | cancelled | lost
  status         String    @default("pending") @db.VarChar(20)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  respondedAt    DateTime? @map("responded_at") @db.Timestamptz(3)
  appointmentId  String?   @map("appointment_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  release WaitlistRelease @relation(fields: [organizationId, releaseId], references: [organizationId, id], onDelete: Cascade)
  entry   WaitlistEntry   @relation(fields: [organizationId, entryId], references: [organizationId, id], onDelete: Cascade)

  @@index([releaseId, status])
  @@index([entryId, status])
  @@map("waitlist_offers")
}

/// Идемпотентность (§21). scope включает тип операции и субъекта (IP/пользователь).
model IdempotencyKey {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope          String    @db.VarChar(200)
  key            String    @db.VarChar(100)
  requestHash    String    @map("request_hash") @db.VarChar(64)
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// ================= ПУБЛИЧНЫЕ СТРАНИЦЫ (§20.5) =================

model PageTemplate {
