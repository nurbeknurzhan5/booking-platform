  resources    Resource[]

  @@unique([organizationId, id])
  @@index([organizationId, kind])
  @@map("media_assets")
}

// ================= КОММУНИКАЦИИ (§20.6) =================

model NotificationTemplate {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                 String              @db.VarChar(40)
  channel              NotificationChannel
  locale               String              @db.VarChar(2)
  /// Имя одобренного шаблона Meta (для WhatsApp).
  providerTemplateName String?             @map("provider_template_name") @db.VarChar(100)
  /// AUTHENTICATION | UTILITY | MARKETING (категории Meta)
  category             String              @db.VarChar(20)
  /// Текст для SMS/dev_inbox с плейсхолдерами {{name}}.
  body                 String
  /// Порядок параметров шаблона Meta.
  variables            Json                @default("[]")
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([type, channel, locale])
  @@map("notification_templates")
}

model NotificationEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  type           String   @db.VarChar(40)
  /// Уникальный ключ события: повторная обработка не создаёт дубликатов (§15.2).
  dedupeKey      String   @unique @map("dedupe_key") @db.VarChar(200)
  appointmentId  String?  @map("appointment_id") @db.Uuid
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  messages NotificationOutbox[]

  @@index([appointmentId])
  @@map("notification_events")
}

model NotificationOutbox {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String?             @map("organization_id") @db.Uuid
  eventId           String              @map("event_id") @db.Uuid
  appointmentId     String?             @map("appointment_id") @db.Uuid
  clientId          String?             @map("client_id") @db.Uuid
  type              String              @db.VarChar(40)
  channel           NotificationChannel
  recipient         String              @db.VarChar(64)
  locale            String              @db.VarChar(2)
  /// Параметры шаблона. Для OTP — зашифрованы (AES-256-GCM) и стираются после отправки.
  payload           Json                @default("{}")
  payloadEncrypted  Boolean             @default(false) @map("payload_encrypted")
  status            NotificationStatus  @default(pending)
  dedupeKey         String              @unique @map("dedupe_key") @db.VarChar(250)
  attempts          Int                 @default(0)
  maxAttempts       Int                 @map("max_attempts")
  nextAttemptAt     DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedAt          DateTime?           @map("locked_at") @db.Timestamptz(3)
  lockedBy          String?             @map("locked_by") @db.VarChar(100)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?           @map("delivered_at") @db.Timestamptz(3)
  readAt            DateTime?           @map("read_at") @db.Timestamptz(3)
  providerMessageId String?             @map("provider_message_id") @db.VarChar(200)
  lastError         String?             @map("last_error")
  expiresAt         DateTime?           @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       NotificationEvent       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  attemptsLog NotificationAttempt[]
  statuses    WhatsappMessageStatus[]

  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@index([appointmentId])
  @@index([providerMessageId])
  @@index([recipient, type, createdAt])
  @@map("notification_outbox")
}

model NotificationAttempt {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outboxId          String    @map("outbox_id") @db.Uuid
  attemptNo         Int       @map("attempt_no")
  startedAt         DateTime  @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz(3)
  success           Boolean
  providerMessageId String?   @map("provider_message_id") @db.VarChar(200)
  httpStatus        Int?      @map("http_status")
  errorCode         String?   @map("error_code") @db.VarChar(100)
  errorMessage      String?   @map("error_message")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  outbox NotificationOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@index([outboxId])
  @@map("notification_attempts")
}

model WhatsappAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// NULL — платформенный аккаунт по умолчанию.
  organizationId String?  @map("organization_id") @db.Uuid
  wabaId         String   @map("waba_id") @db.VarChar(64)
  phoneNumberId  String   @unique @map("phone_number_id") @db.VarChar(64)
  displayPhone   String?  @map("display_phone") @db.VarChar(32)
  accessTokenEnc String   @map("access_token_enc")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("whatsapp_accounts")
}

model WhatsappMessageStatus {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outboxId          String?  @map("outbox_id") @db.Uuid
  providerMessageId String   @map("provider_message_id") @db.VarChar(200)
  status            String   @db.VarChar(20)
  errorCode         String?  @map("error_code") @db.VarChar(50)
  errorTitle        String?  @map("error_title") @db.VarChar(300)
  occurredAt        DateTime @map("occurred_at") @db.Timestamptz(3)
  raw               Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  outbox NotificationOutbox? @relation(fields: [outboxId], references: [id], onDelete: SetNull)

  @@unique([providerMessageId, status])
  @@map("whatsapp_message_statuses")
}

/// Входящие сообщения WhatsApp (D-32): только факт и принятое действие, текст не хранится.
/// Уникальный id сообщения Meta — повторная доставка webhook не даёт второго ответа. Хранится 30 дней.
model WhatsappInboundMessage {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerMessageId String   @unique @map("provider_message_id") @db.VarChar(200)
  phone             String   @db.VarChar(20)
  messageType       String   @map("message_type") @db.VarChar(30)
  /// auto_reply | unsubscribe | throttled | ignored
  action            String   @db.VarChar(20)
  receivedAt        DateTime @map("received_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("whatsapp_inbound_messages")
}

/// Канал dev_inbox: только для dev/test (запрещён в production конфигурацией).
model DevInboxMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipient String   @db.VarChar(64)
  type      String   @db.VarChar(40)
  text      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([recipient, createdAt])
  @@map("dev_inbox_messages")
}

// ================= ДОПОЛНИТЕЛЬНО (§20.7) =================

model Review {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  branchId          String       @map("branch_id") @db.Uuid
  appointmentId     String       @unique @map("appointment_id") @db.Uuid
  clientId          String       @map("client_id") @db.Uuid
  rating            Int
  /// Текст и оценка неизменяемы (триггер в миграции constraints).
  text              String?
  authorName        String       @map("author_name") @db.VarChar(200)
  status            ReviewStatus @default(published)
  reply             String?
  repliedAt         DateTime?    @map("replied_at") @db.Timestamptz(3)
  repliedByUserId   String?      @map("replied_by_user_id") @db.Uuid
  reportedAt        DateTime?    @map("reported_at") @db.Timestamptz(3)
  reportReason      String?      @map("report_reason")
  moderationReason  String?      @map("moderation_reason")
  moderatedAt       DateTime?    @map("moderated_at") @db.Timestamptz(3)
  moderatedByUserId String?      @map("moderated_by_user_id") @db.Uuid
