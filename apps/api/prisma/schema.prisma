  updatedByUserId       String?  @map("updated_by_user_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  page            PublicPage          @relation(fields: [organizationId, pageId], references: [organizationId, id], onDelete: Cascade)
  template        PageTemplate        @relation(fields: [templateId], references: [id])
  templateVersion PageTemplateVersion @relation(fields: [templateVersionId], references: [id])

  @@unique([organizationId, pageId])
  @@map("page_drafts")
}

/// Неизменяемый снимок опубликованной версии страницы.
model PagePublication {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  pageId                String   @map("page_id") @db.Uuid
  version               Int
  content               Json
  /// Снимок переводов контента страницы на момент публикации.
  translations          Json     @default("{}")
  templateId            String   @map("template_id") @db.Uuid
  templateVersionId     String   @map("template_version_id") @db.Uuid
  colorScheme           String   @map("color_scheme") @db.VarChar(40)
  bookingButtonPosition String   @map("booking_button_position") @db.VarChar(20)
  primaryLocale         String   @map("primary_locale") @db.VarChar(2)
  publishedByUserId     String?  @map("published_by_user_id") @db.Uuid
