# ============================================================
# Пример конфигурации. Скопируйте в apps/api/.env (и apps/web/.env.local для frontend).
# НИКОГДА не коммитьте реальные значения.
# ============================================================

# --- Общие ---
NODE_ENV=development
# development | test | production. При NODE_ENV=production задавать обязательно (иначе API и воркер не запустятся)
APP_ENV=development
PORT=4000
LOG_LEVEL=info
# Адрес frontend (CORS, ссылки в уведомлениях)
WEB_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
# Сколько прокси перед API перезаписывают X-Forwarded-For (IP клиента для лимитов частоты, D-54).
# 0 — локально, в CI/E2E и Codespaces: браузер → Next.js → API, а Next.js присланный клиентом заголовок
# пропускает как есть (с 1 его можно подделать и обойти лимиты). 1 — только за Caddy (infra/docker-compose.prod.yml).
TRUST_PROXY=0
# Secure-cookie (true в production за HTTPS)
COOKIE_SECURE=false

# --- База данных (production и тест — разные базы!) ---
DATABASE_URL=postgresql://booking_app:CHANGE_ME@localhost:5432/booking_dev?schema=public
SHADOW_DATABASE_URL=postgresql://booking_app:CHANGE_ME@localhost:5432/booking_shadow?schema=public
TEST_DATABASE_URL=postgresql://booking_app:CHANGE_ME@localhost:5432/booking_test?schema=public
DATABASE_POOL_SIZE=20

# --- Секреты (сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ---
# HMAC для хранения OTP
OTP_HMAC_SECRET=CHANGE_ME_BASE64_32_BYTES
# AES-256-GCM для токенов интеграций, MFA-секретов и OTP в outbox
ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
# Соль для анонимных идентификаторов посетителей (аналитика)
ANALYTICS_SECRET=CHANGE_ME_BASE64_32_BYTES

# --- Уведомления ---
# Список включённых каналов через запятую: whatsapp,sms,dev_inbox (dev_inbox запрещён при APP_ENV=production)
NOTIFICATION_CHANNELS=dev_inbox
# «Тестовый телефон»: канал dev_inbox и GET /api/v1/dev/inbox (страница /dev/phone). По умолчанию false.
# Включается только явно — локальная разработка, Codespaces, CI/E2E. При APP_ENV=production запрещён (API не стартует),
# канал dev_inbox в NOTIFICATION_CHANNELS без этого флага — тоже ошибка конфигурации.
DEV_INBOX_ENABLED=true
# Канал OTP по приоритету
OTP_CHANNELS=whatsapp,sms

# --- WhatsApp Business Platform (официальный Cloud API Meta) ---
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# App Secret — проверка подписи X-Hub-Signature-256 webhook
WHATSAPP_APP_SECRET=
# Verify token для подтверждения webhook
WHATSAPP_VERIFY_TOKEN=

# --- SMS (подключаемый канал; провайдер: mobizon) ---
SMS_PROVIDER=mobizon
SMS_API_BASE_URL=https://api.mobizon.kz
SMS_API_KEY=
SMS_SENDER=

# --- Автоперевод (Google Cloud Translation v2) ---
GOOGLE_TRANSLATE_API_KEY=

# --- Файлы ---
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Публичный базовый URL файлов: при локальном хранилище — через API (/api/v1/media), в production — CDN/S3
STORAGE_PUBLIC_BASE_URL=/api/v1/media
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=5242880

# --- Frontend (apps/web/.env.local) ---
# Адрес API для серверного рендеринга Next.js
API_INTERNAL_URL=http://localhost:4000
# Ключ 2GIS MapGL (если пусто — показывается ссылка «Открыть в 2GIS»)
NEXT_PUBLIC_2GIS_KEY=
# «Тестовый телефон» на сайте (/dev/phone, ссылка «Открыть тестовый телефон»). Подставляется при сборке Next.js.
# Только для разработки, вместе с DEV_INBOX_ENABLED=true у API; в production не задавать.
NEXT_PUBLIC_DEV_INBOX_ENABLED=true
