# Production-переменные для infra/docker-compose.prod.yml. Скопируйте в infra/.env.prod и заполните.
# Никогда не коммитьте заполненный файл. Генерация секретов:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VERSION=1.0.0
DOMAIN=booking.example.kz

# Окружение (справочно): docker-compose.prod.yml закрепляет NODE_ENV=production, APP_ENV=production и
# DEV_INBOX_ENABLED=false для migrate, api и worker. При NODE_ENV=production без явного APP_ENV, а также
# при APP_ENV=production вместе с DEV_INBOX_ENABLED=true API и воркер не запускаются (ошибка конфигурации).
APP_ENV=production
DEV_INBOX_ENABLED=false

POSTGRES_USER=booking
POSTGRES_PASSWORD=
POSTGRES_DB=booking_prod
BACKUP_RETENTION_DAYS=14

OTP_HMAC_SECRET=
ENCRYPTION_KEY=
ANALYTICS_SECRET=

# Каналы: whatsapp,sms (dev_inbox запрещён в production)
NOTIFICATION_CHANNELS=whatsapp
OTP_CHANNELS=whatsapp,sms

# WhatsApp Business Platform (Cloud API) — предоставляет заказчик (R-01)
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# SMS (R-02)
SMS_PROVIDER=mobizon
SMS_API_KEY=
SMS_SENDER=

# Автоперевод (R-03)
GOOGLE_TRANSLATE_API_KEY=

# 2GIS MapGL (R-04)
NEXT_PUBLIC_2GIS_KEY=

# Объектное хранилище S3-совместимое (в РК) (R-05)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=https://cdn.example.kz
